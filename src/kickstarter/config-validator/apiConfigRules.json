                "type" :"string",
                "mandatory": true
            },
            "name" : {
                "type" :"string",
                "mandatory": true
            },
            "routes" : {
                "type" : "array",
                "mandatory" : "true",
                "elements": {
                    "type": "object",
                    "fields": {
                        "strip_path": {
                            "type": "boolean",
                            "mandatory": false
                        },
                        "preserve_host": {
                            "type": "boolean",
                            "mandatory": false
                        },
                        "hosts": {
                            "type" : "array",
                            "mandatory" : false,
                            "elements": {
                                "type": "string"
                            }
                        },
                        "headers": {
                            "type": "object",
                            "mandatory": false,
                            "elements": {
                                "type": "array",
                                "elements": {
                                    "type": "string"
                                }
                            }
                        },
                        "paths": {
                            "type" : "array",
                            "mandatory" : "true",
                            "elements": {
                                "type": "string"
                            }
                        },
                        "protocols":{
                            "type" : "array",
                            "mandatory" : false,
                            "elements": {
                                "type": "string"
                            }
                        },
