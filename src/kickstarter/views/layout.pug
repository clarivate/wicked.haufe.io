    script(src='/js/uiv/uiv.min.js')
    script(src='/js/kickstarter-components.js')
    
    script(type='text/javascript').
      function setRedirect(target) {
        document.getElementById('redirect').value = target;
      }

      function checkChange(event, checkboxId) {
        var isChecked = $("#" + checkboxId).prop("checked");
        var encryptCbId = checkboxId + '_';
        var encryptChecked = $("#" + encryptCbId).prop("checked");
        if (!isChecked && encryptChecked)
          $("#" + encryptCbId).prop("checked", false);
        if (isChecked)
          $("#" + encryptCbId).removeAttr("disabled");
        else
          $("#" + encryptCbId).attr("disabled", true);
      }

      var selectedEnvironment = '';

      function handleEnvironmentChange() {
        var selector = document.getElementById('environmentSelector');
        selectedEnvironment = selector.value;
      
        if (selectedEnvironment && selectedEnvironment !== '') {
          localStorage.setItem('selectedEnvironment', selectedEnvironment);
        } else {
          localStorage.removeItem('selectedEnvironment');
        }
      }

      function loadSelectedEnvironment() {
        var savedEnvironment = localStorage.getItem('selectedEnvironment');
        if (savedEnvironment) {
          selectedEnvironment = savedEnvironment;
          var selector = document.getElementById('environmentSelector');
          if (selector) {
            selector.value = savedEnvironment;
          }
        }
      }

      function validateEnvironmentSelection(event, targetHref) {
       
        var currentEnvironment = selectedEnvironment || localStorage.getItem('selectedEnvironment');
        if (!currentEnvironment || currentEnvironment === '') {
          event.preventDefault();
          showEnvironmentAlert();

          return false;
        }
        return true;
      }

      function showEnvironmentAlert() {
        $('#modalTitle').text('Environment Selection Required');
        $('#modalContent').html('<p>Please choose the environment before proceeding.</p>');
        $('#modalDialog').modal('show');

        $('#modalDialog').off('hidden.bs.modal').on('hidden.bs.modal', function () {
          var selector = document.getElementById('environmentSelector');
          var currentEnvironment = selectedEnvironment || localStorage.getItem('selectedEnvironment');
          if (!currentEnvironment || currentEnvironment === '') {
            selector.classList.add('highlight-env');
          }
        });
      }

      function handleEnvironmentChange() {
        var selector = document.getElementById('environmentSelector');
        selectedEnvironment = selector.value;
        if (selectedEnvironment && selectedEnvironment !== '') {
          localStorage.setItem('selectedEnvironment', selectedEnvironment);
          fetch('/envchange/change', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ env: selectedEnvironment })
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              localStorage.setItem('selectedEnvironment', selectedEnvironment);
              console.log('Environment changed:', data);
              window.location.reload();
            } else {
              alert('Failed to change environment: ' + (data.error || 'Unknown error'));
            }
          })
          .catch(err => {
            alert('Error changing environment: ' + err);
          });
        } else {
          localStorage.removeItem('selectedEnvironment');
        }
      }

      $(document).ready(function() {
     
        loadSelectedEnvironment();
        var selector = document.getElementById('environmentSelector');
        if (selector) {
          selector.addEventListener('change', function() {
            if (selector.value && selector.value !== '') {
              selector.classList.remove('highlight-env');
            }
          });
        } 

        $('a[href]:not([href="/"]').click(function(event) {
          var href = $(this).attr('href');
          return validateEnvironmentSelection(event, href);
        });
      });


